# TLS gateway for the MCP servers (PAF requires https for MCP URLs).
# Terminates TLS with a self-signed cert (SAN=mcp-proxy) and reverse-proxies
# each path prefix to the plain-HTTP MCP app. `handle_path` strips the prefix
# (/banking/mcp -> /mcp), then `uri strip_suffix /` removes any trailing slash
# so the app always sees its canonical `/mcp` and never issues the 307
# /mcp/ -> /mcp redirect (which, behind a path-stripping proxy, would point at
# a prefix-less http:// URL and break the MCP handshake). So both
# https://mcp-proxy:8443/banking/mcp and .../banking/mcp/ work.
# `flush_interval -1` disables buffering so streamable-http (SSE) passes through.
# Cert generated by `manage.py local mcp-tls`; PAF trusts it because the CA is
# uploaded to its administrator certificate store by `manage.py paf trust-ca`.
{
	auto_https off
	admin off
}

:8443 {
	tls /etc/caddy/certs/mcp-proxy.crt /etc/caddy/certs/mcp-proxy.key

	handle_path /banking/* {
		uri strip_suffix /
		reverse_proxy banking-mcp:8503 {
			flush_interval -1
		}
	}
	handle_path /opa/* {
		uri strip_suffix /
		reverse_proxy opa-mcp:8500 {
			flush_interval -1
		}
	}
	handle_path /hitl/* {
		uri strip_suffix /
		reverse_proxy hitl-mcp:8502 {
			flush_interval -1
		}
	}
	handle_path /application/* {
		uri strip_suffix /
		reverse_proxy application-mcp:8504 {
			flush_interval -1
		}
	}
}
