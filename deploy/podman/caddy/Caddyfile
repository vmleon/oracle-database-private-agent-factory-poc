{
  # Disable the admin endpoint (we don't need API control) and skip
  # Caddy's automatic public certificate dance — we provide our own
  # self-signed cert via `tls` below.
  auto_https off
  admin off
}

# HTTPS proxy in front of Ollama so Oracle 26ai's DBMS_CLOUD_AI (which
# rejects HTTP endpoints in the on-prem build) can reach the same Ollama
# backend PAF uses. The cert is pre-generated by `manage.py local up`
# (one-time, ~5 sec); the matching CA root is copied into the Oracle
# container's OS trust store so Oracle accepts the TLS handshake.
#
# OLLAMA_HOST / OLLAMA_PORT come from .env via the compose `environment`
# block. extra_hosts on this service resolves a `.local` mDNS upstream
# (e.g. spark-bc8a.local) inside the container.
:443 {
  log {
    output stdout
    format console
  }
  tls /etc/caddy/tls/server.crt /etc/caddy/tls/server.key
  reverse_proxy http://{$OLLAMA_HOST}:{$OLLAMA_PORT} {
    # Ollama's OpenAI-compatible API lives under /v1; pass everything
    # through. Health probes can use /api/tags upstream.
    flush_interval -1
    header_up Host {upstream_hostport}
  }
}
