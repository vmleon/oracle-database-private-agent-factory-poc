[Unit]
Description=Company registry API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory={{ app_dir }}/registry
# PAF imports this service's OpenAPI document and calls the URL it advertises,
# so the document has to name this host rather than a compose service.
Environment=REGISTRY_PUBLIC_URL=http://{{ self_host }}:8600
# PAF imports this service's OpenAPI document as an HTTP datasource, so it
# binds on the VCN address rather than loopback.
ExecStart={{ app_dir }}/registry/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8600
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
