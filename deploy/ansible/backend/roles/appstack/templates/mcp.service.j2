[Unit]
Description=MCP wrapper — {{ item.name }}
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory={{ app_dir }}/mcp/{{ item.name }}
# TNS_ADMIN points the wrappers at the ADB wallet, which supplies both the
# service alias in DB_DSN and the mTLS certificates.
Environment=PORT={{ item.port }}
Environment=TNS_ADMIN={{ wallet_dir }}
Environment=DB_DSN={{ adb_service }}
Environment=DB_WALLET_PASSWORD={{ wallet_password }}
{% if item.db_user is defined %}
# Each wrapper connects as the client user for the audience it serves, so a
# compromised wrapper reaches only what that audience is allowed to see.
Environment=DB_USER={{ item.db_user }}
Environment=DB_PASSWORD={{ lookup('vars', item.db_password_var) }}
{% endif %}
Environment=BACKEND_URL=http://{{ self_host }}:8090
Environment=OPA_URL=http://127.0.0.1:8181
Environment=REGISTRY_URL=http://{{ self_host }}:8600
Environment=BANKING_MCP_URL=http://127.0.0.1:8503/mcp
# PAF opens an MCP session per tool call and per tool discovery and leaves most
# of their SSE streams open, so a wrapper's open sockets climb with sustained
# use. The systemd default soft limit of 1024 is reached within a few test runs.
LimitNOFILE=65536
ExecStart={{ app_dir }}/mcp/{{ item.name }}/venv/bin/python server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
