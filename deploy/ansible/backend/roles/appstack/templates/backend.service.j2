[Unit]
Description=PAF PoC application backend
After=network-online.target paf-poc-opa.service
Wants=network-online.target

[Service]
# TNS_ADMIN points the JDBC driver at the unpacked ADB wallet, so the JDBC URL
# carries the service alias rather than a host and port.
Environment=TNS_ADMIN={{ wallet_dir }}
Environment=SPRING_DATASOURCE_URL=jdbc:oracle:thin:@{{ adb_service }}?TNS_ADMIN={{ wallet_dir }}
Environment=SPRING_DATASOURCE_USERNAME=SVC_BACKEND
Environment=SPRING_DATASOURCE_PASSWORD={{ db_backend_password }}
Environment=PAF_BASE_URL=https://{{ paf_host }}:8080
Environment=OPA_URL=http://127.0.0.1:8181
# PAF_AGENT_ID and PAF_API_KEY come from here: the flow is published long after
# the tier is built, so the key cannot be rendered into the unit. The leading
# `-` lets the service start before `paf api-key` has written the file.
EnvironmentFile=-/etc/paf-poc-backend.env
ExecStart=/usr/bin/java -jar {{ app_dir }}/app.jar
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
