[Unit]
Description=Private Agent Factory
After=network-online.target
Wants=network-online.target

[Service]
# Models are served by the managed OCI Generative AI endpoint, so no inference
# container runs alongside PAF on this host.
ExecStart=/usr/bin/podman run --rm --name paf \
  --network host \
  -v {{ wallet_dir }}:/opt/paf/wallet:Z \
  -e TNS_ADMIN=/opt/paf/wallet \
  -e ADB_SERVICE={{ adb_service }} \
  -e GENAI_ENDPOINT={{ genai_endpoint }} \
  -e GENAI_REGION={{ genai_region }} \
  -e BACKEND_URL=http://{{ backend_host }}:8080 \
  localhost/applied-ai-label:{{ paf_app_version }}
ExecStop=/usr/bin/podman stop -t 30 paf
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
