# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/

# Node
node_modules/
dist/
build/

# Java / Gradle
.gradle/
out/
*.class
*.jar

# Environment / secrets
.env
.env.*
!.env.example
wallets/
*.wallet
**/wallet/

# Terraform
**/.terraform/
**/terraform.tfstate*
**/terraform.tfvars
**/generated/

# Ansible
deploy/ansible/**/.vars.*.yml
deploy/ansible/**/*.retry

# Liquibase
**/liquibase.properties

# PAF kit extracted from the vendor tarball for source reading; ~6 GB, never commit
paf-kit/

# Playwright (browser-driven verification artifacts)
.playwright-mcp/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Logs
*.log
logs/

# Spring Boot backend
src/backend/.gradle/
src/backend/build/

# Cloud build output — `manage.py build` stages these, `manage.py clean` removes them
deploy/ansible/*/roles/*/files/*
!deploy/ansible/*/roles/*/files/.gitkeep
deploy/tf/app/generated/

# PAF kit tarball — a vendor download, far too large to commit. The generic
# `dist/` rule above would exclude the directory itself, and git cannot
# re-include a file inside an excluded directory, so the directory is
# re-admitted first.
!paf/dist/
paf/dist/*
!paf/dist/README.md

