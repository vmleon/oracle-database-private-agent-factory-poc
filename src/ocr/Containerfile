# OCR service for the PAF Decisioning Engine PoC.
# Designed to run on a LAN GPU host (DGX Spark or commodity NVIDIA box).
#
# Base image: NVIDIA NGC PyTorch container. Multi-arch (works on DGX Spark's
# Grace+Blackwell ARM platform and on x86_64 with NVIDIA GPUs). Bump the tag
# as new releases land at https://catalog.ngc.nvidia.com/orgs/nvidia/containers/pytorch
FROM nvcr.io/nvidia/pytorch:25.01-py3

WORKDIR /app

# libgl1 / libglib2.0-0 are needed by PIL/cv2 when decoding some image formats.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

# Install docTR + FastAPI. The base image already provides torch/cuda;
# pip will not reinstall it.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

ENV OCR_PORT=8500 \
    OCR_USABLE_MIN_CONFIDENCE=0.85 \
    OCR_MARGINAL_MIN_CONFIDENCE=0.60

EXPOSE 8500

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD python -c "import os,urllib.request,sys; urllib.request.urlopen(f'http://localhost:{os.environ.get(\"OCR_PORT\",\"8500\")}/health', timeout=5).read()" \
  || exit 1

CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${OCR_PORT}"]
